{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Audio",
  "version": "1.4.0",
  "identifier": "com.syncaudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd ../engine && uv run python packaging/build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bobine Audio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/syncaudio-engine/": "engine/"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "conflicts": ["sync-audio"],
        "replaces": ["sync-audio"]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "headerImage": "./windows/installer-header.bmp",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMjBDQzI3QTU1RTQzNzAKUldSd1ExNmxKOHdnVGR5SXhXVFg0UUdPUlNmL3kyTkc1TUx0V3FaWW5DUndGSkQzR2Z4Y1F2NUMK",
      "endpoints": [
        "https://github.com/MarcValat/BobineAudio/releases/latest/download/latest.json"
      ]
    }
  }
}
