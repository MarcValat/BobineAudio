{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bobine Audio",
  "version": "1.5.0",
  "identifier": "com.syncaudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cd ../engine && uv run python packaging/build_sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bobine Audio",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/syncaudio-engine/": "engine/"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "conflicts": ["sync-audio"],
        "replaces": ["sync-audio"],
        "desktopTemplate": "./linux/hidden.desktop.hbs",
        "files": {
          "/usr/share/applications/com.syncaudio.app.desktop": "./linux/com.syncaudio.app.desktop",
          "/usr/share/metainfo/com.syncaudio.app.metainfo.xml": "./linux/com.syncaudio.app.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/bobine-audio.png": "./icons/32x32.png",
          "/usr/share/icons/hicolor/64x64/apps/bobine-audio.png": "./icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/bobine-audio.png": "./icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/bobine-audio.png": "./icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/bobine-audio.png": "./icons/icon.png",
          "/usr/share/icons/hicolor/scalable/apps/bobine-audio.svg": "./icons/icon-source.svg"
        },
        "postInstallScript": "./linux/refresh-desktop.sh",
        "postRemoveScript": "./linux/refresh-desktop.sh"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "./windows/installer-sidebar.bmp",
        "headerImage": "./windows/installer-header.bmp",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMjBDQzI3QTU1RTQzNzAKUldSd1ExNmxKOHdnVGR5SXhXVFg0UUdPUlNmL3kyTkc1TUx0V3FaWW5DUndGSkQzR2Z4Y1F2NUMK",
      "endpoints": [
        "https://github.com/MarcValat/BobineAudio/releases/latest/download/latest.json"
      ]
    }
  }
}
