{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncAudio",
  "version": "1.0.4",
  "identifier": "com.syncaudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncAudio",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/syncaudio-engine"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMjBDQzI3QTU1RTQzNzAKUldSd1ExNmxKOHdnVGR5SXhXVFg0UUdPUlNmL3kyTkc1TUx0V3FaWW5DUndGSkQzR2Z4Y1F2NUMK",
      "endpoints": [
        "https://github.com/MarcValat/SyncAudio/releases/latest/download/latest.json"
      ]
    }
  }
}
