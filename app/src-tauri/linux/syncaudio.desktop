# Named after the program: its windows carry that name as their Wayland
# app id (Tauri's enableGTKAppId is off), and KDE finds a window's launcher,
# hence its icon, by that name -- any other name shows a generic "W".
[Desktop Entry]
Type=Application
Name=Bobine Audio
Comment=Resynchronize a video's multilingual audio tracks
Comment[fr]=Resynchronise les pistes audio multilingues d'une vidéo
Keywords=audio;sync;resync;mkv;dub;
Keywords[fr]=audio;synchronisation;resynchroniser;mkv;doublage;
Exec=syncaudio
Icon=bobine-audio
StartupWMClass=syncaudio
Terminal=false
Categories=AudioVideo;Audio;Video;
